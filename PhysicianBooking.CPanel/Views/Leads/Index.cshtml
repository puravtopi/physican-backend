    const searchInput = document.getElementById('SearchInput');
    const searchForm = document.getElementById('SearchForm');

    searchInput.addEventListener('input', function() {
        searchForm.submit();
    });
</script> *@

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

              document.addEventListener("DOMContentLoaded", function () {
            const searchForm = document.getElementById("SearchForm");
            const searchInput = document.getElementById("SearchInput");
            const fromDate = document.getElementById("FromDate");
            const toDate = document.getElementById("ToDate");
            const clearBtn = document.getElementById("btnClear");

            clearBtn.addEventListener("click", function () {
                // 1. Clear all input values
                searchInput.value = "";
                fromDate.value = "";
                toDate.value = "";

                // 2. Submit form to reload all content (clean state)
                searchForm.submit();
            });
        });

        // 1. Prepare data from C# Model to JavaScript
        const businessData = JSON.parse('@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.AllData))');

                // 1. Group the data by Business Name (Place) and count them
        const businessLeadCounts = businessData.reduce((acc, item) => {
            // Note: Use 'Place' or 'place' based on your JSON casing
            const businessName = item.place || item.Place || "Unknown Business";

            acc[businessName] = (acc[businessName] || 0) + 1;
            return acc;
        }, {});

        // 2. Extract labels (Business Names) and data (Lead Counts)
        const barLabels = Object.keys(businessLeadCounts);
        const barDataValues = Object.values(businessLeadCounts);

        // 3. --- BAR CHART (Total Leads per Business) ---
        const ctx1 = document.getElementById('idChart').getContext('2d');
        new Chart(ctx1, {
            type: 'bar',
            data: {
                labels: barLabels, // The names of the dental clinics
                datasets: [{
                    label: 'Total Leads',
                    data: barDataValues, // The number of leads for each clinic
                    backgroundColor: 'rgba(54, 162, 235, 0.6)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false, // Prevents 0px height issue
                plugins: {
                    title: {
                        display: true,
                        text: 'Leads Count by Business'
                    },
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }, // Ensure only whole numbers show
                        title: {
                            display: true,
                            text: 'Number of Leads'
                        }
                    },
                    x: {
                        title: {
                            display: true,
                            text: 'Business Name'
                        }
                    }
                }
            }
        });

                // 1. Group and Count Specialties
        const specialtyCounts = businessData.reduce((acc, item) => {
            // Handle both 'specialty' and 'Specialty' (C# casing)
            const s = item.specialty || item.Specialty || "Unknown";

            // Increment the count for this specialty
            acc[s] = (acc[s] || 0) + 1;
            return acc;
        }, {});

        // 2. Extract Labels (Specialty Names) and Data (Counts)
        const specialtyLabels = Object.keys(specialtyCounts); // e.g., ["dentist", "orthodontist"]
        const specialtyValues = Object.values(specialtyCounts); // e.g., [5, 2]

        // --- PIE CHART (Count by Specialty) ---
        // Note: In your current data, all are 'dentist', so this will show 100% dentist.
              // 3. Create the Pie Chart
        const ctx2 = document.getElementById('specialtyChart').getContext('2d');
        new Chart(ctx2, {
            type: 'pie',
            data: {
                labels: specialtyLabels, // Dynamic labels
                datasets: [{
                    label: 'No of Leads',
                    data: specialtyValues, // Dynamic counts
                    backgroundColor: [
                        '#FF6384', // Red
                        '#36A2EB', // Blue
                        '#FFCE56', // Yellow
                        '#4BC0C0', // Teal
                        '#9966FF', // Purple
                        '#FF9F40'  // Orange
                    ],
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false, // Helps with the 0px height issue
                plugins: {
                    title: {
                        display: true,
                        text: 'Business Specialty Breakdown'
                    },
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    </script>
}
