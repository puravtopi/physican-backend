@model PhysicianBooking.Domain.ViewModel.BaseModel

<div class="tbl-footer">
    <div class="tbl-results-text">
        Results: @Model.CurrentPage of @Model.TotalPages
    </div>


    <div class="d-flex align-items-center gap-1">
        @*   <button class="tbl-page-btn mr-1"><i class="ti-angle-left"></i></button> *@
        @for (var i = 1; i <= Model.TotalPages; i++)
        {
            <a class="tbl-page-btn mr-1  @(i == Model.CurrentPage ? "active" : "")" href="@Url.Action("Index", new { search = Model.SearchTerm, page = i })">@i</a>
        }
        @*   <button class="tbl-page-btn mr-1"><i class="ti-angle-right"></i></button> *@
    </div>

</div>